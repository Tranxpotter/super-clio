{
  "name": "ROS2 Humble Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "privileged": true,
  "containerEnv": {
    "NVIDIA_DRIVER_CAPABILITIES": "all", 
    "NVIDIA_VISIBLE_DEVICES": "all", 
    "DISPLAY": "${localEnv:DISPLAY}", 
    "ROS_LOCALHOST_ONLY": "1", 
    "ROS_DOMAIN_ID": "42"
  },
  "runArgs": [
    "--gpus", "all",
    "--net", "host",
    "--ipc", "host",
    "--shm-size", "4gb"
  ],
  "remoteUser": "root",
  "remoteEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-iot.vscode-ros",
        "xaver.clang-format",
        "twxs.cmake",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash"
          }, 
          "zsh": {
            "path": "zsh"
          }
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode"
    }, 
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "zsh-autosuggestions zsh-syntax-highlighting",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git https://github.com/zsh-users/zsh-syntax-highlighting.git"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/root/ros2_ws,type=bind",
  "workspaceFolder": "/root/ros2_ws",
  "mounts": [
    {
      "source": "${localWorkspaceFolder}/.devcontainer/.zshrc",
      "target": "/root/.zshrc",
      "type": "bind"
    }, 
    {
      "source": "${localWorkspaceFolder}/.colcon/defaults.yaml", 
      "target": "/root/.colcon/defaults.yaml", 
      "type": "bind"
    }, 
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached", 
    "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
  ],
  "postCreateCommand": "bash .devcontainer/setup_zsh.sh"
}
